  "keyFeatures": [
    "Multi-agent configurator supporting Claude Code, OpenCode, Gemini CLI, Cursor, and VS Code Copilot",
    "Interactive TUI with Bubbletea for guided setup",
    "Component-based architecture with 8 ecosystem components",
    "11 curated coding skills including 9-phase SDD workflow",
    "Cross-platform support for macOS, Linux, and Windows",
    "Automatic dependency detection and installation",
    "Dry-run mode for previewing changes",
    "Backup and restore functionality"
  ],
  "publicApiSurface": [
    "gentle-ai",
    "gentle-ai install",
    "gentle-ai install --agent <agents>",
    "gentle-ai install --preset <preset>",
    "gentle-ai install --component <components>",
    "gentle-ai install --skill <skills>",
    "gentle-ai install --persona <persona>",
